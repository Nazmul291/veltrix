{
  "name": "veltrix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate:prod": "node --env-file=.env.production.local node_modules/prisma/build/index.js migrate deploy",
    "admin:bootstrap:prod": "tsx --env-file=.env.production.local scripts/bootstrap-admin.ts",
    "vercel-build": "remix vite:build && node scripts/vercel-migrate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@remix-run/node": "2.16.7",
    "@remix-run/react": "2.16.7",
    "@remix-run/serve": "2.16.7",
    "@remix-run/server-runtime": "2.16.7",
    "@vercel/functions": "^3.0.0",
    "@vercel/remix": "2.16.7",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@remix-run/dev": "2.16.7",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
