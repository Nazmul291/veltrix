# Required. Provider keys (Fly, Neon, Upstash, Paddle) are stored encrypted in the database via /admin/providers.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veltrix"
# 32 bytes, hex-encoded: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=""

# NazmulCodes Auth (central sign-in). Optional fallbacks: values saved in
# Admin → Providers → NazmulCodes Auth take priority. Needed on a fresh install,
# because nobody can sign in to the admin page before these exist.
NAZMULCODES_AUTH_URL="https://auth.nazmulcodes.org"
NAZMULCODES_AUTH_API_KEY=""
# Must exactly match a callback URL registered for Veltrix in the auth admin.
NAZMULCODES_AUTH_REDIRECT_URI="http://localhost:5173/auth/callback"
NAZMULCODES_AUTH_CLIENT_ID="veltrix"
